<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ⚠️ 本文件在构建时会被 xcodegen 整份重写（内容 = 内置默认键 + project.yml 的 info.properties）。
	     唯一真相源是 project.yml；这里同步一份仅供本地查看对照，
	     手写在此处但没写进 project.yml 的键会在构建时被静默丢弃。 -->
	<key>CFBundleDevelopmentRegion</key>
	<string>zh-Hans</string>
	<key>CFBundleDisplayName</key>
	<string>我要报告</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSCameraUsageDescription</key>
	<string>用于拍摄小广告照片进行举报</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>用于从相册选择小广告照片进行举报</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>用于标记小广告所在位置，方便城管定位处理</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
	<key>UIRequiresFullScreen</key>
	<true/>
	<key>UIStatusBarHidden</key>
	<false/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
